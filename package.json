{
  "name": "happier-tui",
  "version": "0.5.0",
  "description": "Terminal client for Happier agent sessions, with bell and notification support for tmux, cmux and other terminals",
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "dev": "tsx src/main.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p . --noEmit",
    "start": "node dist/main.js",
    "prepack": "npm run build",
    "demo": "tsx scripts/demo.ts",
    "screenshots": "vhs scripts/screenshots.tape"
  },
  "keywords": [
    "happier",
    "tui",
    "terminal",
    "coding-agents",
    "tmux",
    "cmux"
  ],
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@earendil-works/pi-tui": "^1.5.2",
    "chalk": "^6.0.1",
    "emphasize": "^7.0.0",
    "socket.io-client": "^4.8.4",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "bin": {
    "happier-tui": "dist/main.js"
  },
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyrilPeponnet/happier-tui.git"
  },
  "homepage": "https://github.com/CyrilPeponnet/happier-tui#readme",
  "bugs": {
    "url": "https://github.com/CyrilPeponnet/happier-tui/issues"
  }
}
